# ==========================================
# Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# ------------------------------------------
# Frontend URL (CORS Configuration)
# ------------------------------------------
# Set this to your frontend URL. All CORS requests from this origin will be allowed.
# For multiple comma-separated origins, e.g.: http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ------------------------------------------
# Database Connection (Supabase PostgreSQL)
# ------------------------------------------
# Find this in Supabase: Project Settings -> Database -> Connection string -> URI
# Mode: Transaction (port 6543) or Session/Direct (port 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional Direct Connection for Prisma Migrations (if using Supabase connection pooler on port 6543 above):
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------
# Authentication / JWT Security
# ------------------------------------------
# Secret key used to sign and verify JWT tokens (generate a strong random string)
JWT_SECRET=super_secret_jwt_key_school_erp_change_me_in_production_32chars!
JWT_EXPIRES_IN=24h