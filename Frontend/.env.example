# ==========================================
# Frontend Environment Configuration (Vite)
# ==========================================

# ------------------------------------------
# Backend API Base URL
# ------------------------------------------
# Single environment variable that configures where the Frontend API layer sends all HTTP requests.
# For local development: http://localhost:5000/api
# For production deployment: https://your-backend-domain.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Application Display Title (optional)
VITE_APP_NAME="Mini School ERP"
